# Personal user config - never synced to GitHub
creator.txt
mse_path.txt

# Auto-generated by launcher with user's name - stays local
MSE2/data/magic.mse-game/custom_script

# Per-user last-sync snapshot (used for deletion detection) - stays local
Shared-Set/**/last_known_*.txt

# Pre-sync safety backups - local only, never push to cloud
# (these pile up fast and cause every user's git reset to pull everyone's backups)
Shared-Set/_pre_sync_backups/
Shared-Set/**/_pre_sync_backups/

# MSE2 auto-save backup file - local only
Shared-Set/**/*.bak
*.bak

# Draft cards file - consumed and deleted during sync, never commit
# (if committed, git reset re-downloads it and cards get re-injected every sync = duplication)
Shared-Set/**/draft_cards_*.txt

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Compiled addon (rebuilt locally)
MenuAddon.exe

# Delete Duplicates vault (local recovery only)
Shared-Set/**/_dedup_vault/

